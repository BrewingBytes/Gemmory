<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission: user photos never leave the phone (AGENTS.md). Photo Picker needs no media permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The one 400ms soft vibration when a picture is finished (design system, Haptics and sound). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Backup is on except for photo canvases and the allowance counter, which the rules exclude from cloud backup
         and device transfer (see res/xml). Bundled-picture progress and settings may be backed up. -->
    <application
        android:name=".GemmoryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gemmory">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
