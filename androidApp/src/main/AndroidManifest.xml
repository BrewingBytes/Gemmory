<?xml version="1.0" encoding="utf-8"?>
<!-- User photos never leave the phone (AGENTS.md): nothing in the app uploads them, and the Photo Picker needs no
     media permission. INTERNET and ACCESS_NETWORK_STATE arrive through ML Kit's merged manifest (its datatransport
     sends ML Kit diagnostics, never images; design doc R3-6, declared in Data safety). AdMob (#7) needs them too. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The one 400ms soft vibration when a picture is finished (design system, Haptics and sound). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Backup is on except for photo canvases and the allowance counter, which the rules exclude from cloud backup
         and device transfer (see res/xml). Bundled-picture progress and settings may be backed up. -->
    <application
        android:name=".GemmoryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gemmory">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
