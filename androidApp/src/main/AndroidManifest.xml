<?xml version="1.0" encoding="utf-8"?>
<!-- User photos never leave the phone (AGENTS.md): nothing in the app uploads them, and the Photo Picker needs no
     media permission. INTERNET and ACCESS_NETWORK_STATE are for AdMob + UMP (#7): ads, the consent form and the
     validated-network check that decides offline vs no-fill (eng D15). ML Kit's datatransport also uses them for its
     diagnostics, never images (design doc R3-6). AdMob merges AD_ID (adults only; declared in Data safety, #5). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The one 400ms soft vibration when a picture is finished (design system, Haptics and sound). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Backup is on except for photo canvases and the allowance counter, which the rules exclude from cloud backup
         and device transfer (see res/xml). Bundled-picture progress and settings may be backed up. -->
    <application
        android:name=".GemmoryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gemmory">
        <!-- Google's sample app ID until production IDs exist (build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the player's own time-lapse (or before/after picture) to the share sheet they open. cacheDir only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
