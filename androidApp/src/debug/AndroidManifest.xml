<?xml version="1.0" encoding="utf-8"?>
<!-- Play Games (#113): the SDK merges PlayGamesInitProvider, which starts Play Games at every process start from the
     games.APP_ID meta-data, whatever BuildConfig.PLAY_GAMES says. On a phone signed in to Google (Test Lab signs one
     in) its automatic sign-in can open GamesResolutionActivity over MainActivity, which the debug key can't
     authorize. Debug builds drop it, so Play Games stays off; `-Pgemmory.playGames=true` still starts it, since
     PlayGamesBackend calls PlayGamesSdk.initialize at the first foreground. Release builds keep it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            android:authorities="${applicationId}.playgamesinitprovider"
            tools:node="remove" />
    </application>
</manifest>
